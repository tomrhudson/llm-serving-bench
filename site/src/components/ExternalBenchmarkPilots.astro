---
import { displayDate, modelUrl, reportUrl } from '../lib/benchmarks.js';

const { config, showConfiguration = false } = Astro.props;
const { date, report, scope, benchmarks } = config.external_evals;
---
<section id="external-benchmarks" class:list={['external-evals', { 'wrap home-section': showConfiguration }]} aria-labelledby="external-benchmarks-heading">
  <div class="section-intro">
    <div>
      <h2 id="external-benchmarks-heading">External benchmark pilots</h2>
      <p class="external-evals-meta">
        {showConfiguration && <><a href={`${modelUrl(config.id)}#external-benchmarks`}>{config.label}</a> · {config.sparks}× DGX Spark · </>}
        <time datetime={date}>{displayDate(date)}</time>
      </p>
    </div>
    <a class="text-link" href={reportUrl(report)}>Read the pilot report</a>
  </div>
  <div class="measure-grid">
    {benchmarks.map(({ name, source, result, notes }) => (
      <article class="card">
        <h3><a href={source}>{name}</a></h3>
        <p><strong>{result}</strong></p>
        <p>{notes}</p>
      </article>
    ))}
  </div>
  <p class="external-evals-scope">{scope}</p>
</section>

<section class:list={['card tool-eval-credit', { wrap: showConfiguration }]} aria-labelledby="tool-eval-credit-heading">
  <h2 id="tool-eval-credit-heading">Standard tool-use benchmark</h2>
  <p><strong>tool-eval-bench by SeraphimSerapis</strong> powers Spark Bench’s Tool eval and Safety gate badges.</p>
  <div class="tool-eval-credit-links">
    <a class="text-link" href="https://github.com/SeraphimSerapis/tool-eval-bench">View upstream repository</a>
    <a class="text-link" href={`${reportUrl('README.md')}#tool-use-quality`}>View tool-use results</a>
  </div>
</section>
