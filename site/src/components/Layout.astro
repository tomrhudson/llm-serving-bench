---
import '../styles/site.css';
import SponsorButton from './SponsorButton.astro';
import { repository } from '../lib/benchmarks.js';

const { title, description, catalog = false } = Astro.props;
const pageTitle = `${title} · Spark Bench`;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const previewImage = new URL('/spark-bench-share.jpg', Astro.site);
const previewAlt = 'Spark Bench. DGX Spark serving benchmarks. Independent LLM benchmarks by Tom Hudson.';
---
<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spark Bench" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={previewImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const key = 'spark-bench-appearance';
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        let preference = 'system';
        let control;

        function readPreference() {
          try {
            const saved = localStorage.getItem(key);
            return saved === 'light' || saved === 'dark' ? saved : 'system';
          } catch {
            return 'system';
          }
        }

        function applyTheme() {
          document.documentElement.dataset.theme =
            preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
        }

        preference = readPreference();
        applyTheme();
        system.addEventListener('change', applyTheme);

        document.addEventListener('DOMContentLoaded', () => {
          control = document.querySelector('#appearance');
          control.value = preference;
          control.closest('label').hidden = false;
          control.addEventListener('change', () => {
            preference = control.value;
            applyTheme();
            try {
              if (preference === 'system') localStorage.removeItem(key);
              else localStorage.setItem(key, preference);
            } catch {
              // Keep the selected theme for this page when storage is unavailable.
            }
          });
        });

        window.addEventListener('storage', (event) => {
          if (event.key !== key && event.key !== null) return;
          preference = readPreference();
          if (control) control.value = preference;
          applyTheme();
        });
      })();
    </script>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
          <span class="mark" aria-hidden="true"></span> Spark Bench
        </a>
        <div class="header-actions">
          <nav aria-label="Primary">
            <a class="button button--ghost button--sm" href="/models/" aria-current={catalog ? 'page' : undefined}>Model catalog</a>
            <a class="button button--ghost button--sm" href="/summary/" aria-current={Astro.url.pathname === '/summary/' ? 'page' : undefined}>Top 5</a>
            <a class="button button--ghost button--sm" href="/compare/" aria-current={Astro.url.pathname === '/compare/' ? 'page' : undefined}>Compare</a>
            <a class="button button--ghost button--sm source-nav" href={repository}>GitHub</a>
            <SponsorButton class="button--outline button--sm sponsor-nav" />
          </nav>
          <label class="appearance" for="appearance" hidden>
            <span>Appearance</span>
            <select id="appearance">
              <option value="system">System</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="wrap footer-inner">
        <span>Spark Bench <span class="footer-by">by Tom Hudson</span></span>
        <nav aria-label="Sources">
          <a href={`${repository}#fair-comparisons`}>Methodology</a>
          <a href={`${repository}/blob/main/results/MODEL-GUIDE.md`}>Model guide</a>
          <a href={repository}>Source on GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
