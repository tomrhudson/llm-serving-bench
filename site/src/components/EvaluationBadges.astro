---
import EvaluationChip from './EvaluationChip.astro';

const { config } = Astro.props;
---
<div class="card-status">
  <EvaluationChip status={config.toolStatus}>Tool eval {config.toolStatus}</EvaluationChip>
  {config.tool_eval && <EvaluationChip status={config.safetyGate}>Safety gate {config.safetyGate}</EvaluationChip>}
</div>
