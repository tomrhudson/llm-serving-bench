---
import EvaluationBadges from '../components/EvaluationBadges.astro';
import InstallDialog from '../components/InstallDialog.astro';
import InstallModelButton from '../components/InstallModelButton.astro';
import Layout from '../components/Layout.astro';
import WorkloadPicker from '../components/WorkloadPicker.astro';
import { baselines, displayDate, families, decodeWorkload, modelUrl, rate, repository } from '../lib/benchmarks.js';

const latest = baselines.find((config) => config.decode.length);
const measuredDecode = (latest?.decode ?? []).filter((row) => row.output_tps != null);
const maxRate = Math.max(1, ...measuredDecode.map((row) => row.output_tps));
---
<Layout title="DGX Spark benchmarks" description="Independent, configuration-level LLM serving benchmarks for NVIDIA DGX Spark.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Independent benchmarks by Tom Hudson</p>
        <h1>DGX Spark<br /><span>serving benchmarks</span></h1>
        <p class="hero-lead">Find what runs on your DGX Spark setup and see how the exact configuration performed under load.</p>
        <div class="actions">
          <a class="button button--primary button--lg" href="/models/">Browse the model catalog</a>
          <a class="button button--outline button--lg" href="#workloads">Choose by workload</a>
        </div>
      </div>
      {measuredDecode.length > 0 && (
        <figure class="card sample">
          <figcaption>
            <span class="kicker">Latest serving benchmark · <time datetime={latest.date}>{displayDate(latest.date)}</time></span>
            <a href={modelUrl(latest.id)}>{latest.model.name}</a>
            <span>{latest.sparks}× DGX Spark · {latest.runtime} · Decode sweep</span>
          </figcaption>
          <EvaluationBadges config={latest} />
          <dl class="sample-rows">
            {measuredDecode.map((row) => (
              <div>
                <dt>c{row.concurrency}</dt>
                <dd><span class="track" aria-hidden="true"><span style={`width:${row.output_tps / maxRate * 100}%`}></span></span>{rate(row.output_tps)}</dd>
              </div>
            ))}
          </dl>
          <p class="sample-unit">Aggregate output tok/s by concurrency · {decodeWorkload}</p>
          <InstallModelButton config={latest} />
        </figure>
      )}
    </div>
  </section>

  <WorkloadPicker />

  <section class="wrap home-section" aria-labelledby="measured-heading">
    <div class="section-intro">
      <div>
        <p class="kicker">{families.length} model families · {baselines.length} configurations</p>
        <h2 id="measured-heading">What the benchmarks measure</h2>
      </div>
      <a class="text-link" href={`${repository}#standard-suite`}>Benchmark methodology</a>
    </div>
    <div class="measure-grid">
      <div class="card"><h3>Interactive speed</h3><p>Single-stream generation speed and time to first token across a sweep of request concurrency.</p></div>
      <div class="card"><h3>Throughput under load</h3><p>Aggregate output rate, latency and errors during a sustained serving test.</p></div>
      <div class="card"><h3>Context and tool use</h3><p>Prompt lengths actually exercised, passkey retrieval, and published mock-tool evaluations with completion and safety-gate status.</p></div>
    </div>
    <div class="measure-grid measure-definitions">
      <div class="card">
        <h3>Tool eval</h3>
        <p>Tests how well a model uses simulated tools, including choosing the right tool, supplying the right arguments, and completing multi-step tasks. A complete run has a score for every scenario in every trial.</p>
      </div>
      <div class="card">
        <h3>Safety gate</h3>
        <p>A pass/fail check on critical tool behavior, such as respecting permissions and waiting for required steps before taking an action. The gate is reported separately from the overall tool eval score.</p>
      </div>
    </div>
  </section>
  <InstallDialog />
</Layout>
