---
import CompareButton from '../components/CompareButton.astro';
import CompareSelection from '../components/CompareSelection.astro';
import EvaluationBadges from '../components/EvaluationBadges.astro';
import InstallDialog from '../components/InstallDialog.astro';
import InstallModelButton from '../components/InstallModelButton.astro';
import Layout from '../components/Layout.astro';
import SparkCountFilter from '../components/SparkCountFilter.astro';
import {
  benchmarkLeaders, decodeWorkload, modelUrl, number, passkeyTokens, rate, repository, soakConcurrency, soakMinutes, sparkCounts,
} from '../lib/benchmarks.js';

const rankings = [undefined, ...sparkCounts].map((sparks) => ({
  count: sparks == null ? '' : String(sparks),
  leaders: benchmarkLeaders(sparks),
}));
const results = `${repository}/blob/main/results/README.md`;
const boards = [
  {
    id: 'decode-scaling', title: 'Decode scaling', metric: 'decode', unit: 'output tok/s',
    description: `Highest aggregate throughput at any measured concurrency using ${decodeWorkload}. Higher concurrency can include queueing.`,
  },
  {
    id: 'long-context-prefill', title: 'Long-context prefill', metric: 'prefill', unit: 's',
    description: `Lowest p95 time to first token on the ${number(passkeyTokens)}-token passkey workload at concurrency 1.`,
  },
  {
    id: 'sustained-load', title: 'Sustained load', metric: 'soak', unit: 'output tok/s',
    description: `Highest aggregate throughput in the ${soakMinutes}-minute test at concurrency ${soakConcurrency}, with zero request errors.`,
  },
];
---
<Layout title="Top 5" description="Top five DGX Spark model families by peak decode throughput, long-context prefill latency, and sustained throughput.">
  <div class="mast">
    <div class="wrap">
      <h1 tabindex="-1">Top 5 models by benchmark</h1>
      <p class="hero-lead">Each ranking uses the best measured configuration per model family. Spark count and serving runtime can vary across entries.</p>
    </div>
  </div>

  <div class="wrap detail">
    <div class="card filters summary-filters" id="summary-filters" hidden>
      <SparkCountFilter />
    </div>
    <CompareSelection />
    {boards.map(({ id, title, description, metric, unit }) => (
      <section id={id} class="card summary-board" aria-labelledby={`${id}-heading`}>
        <div class="summary-intro">
          <h2 id={`${id}-heading`}>{title}</h2>
          <p>{description}</p>
          <a class="text-link" href={`${results}#${id}`}>View {title.toLowerCase()} chart</a>
        </div>
        {rankings.map(({ count, leaders }) => leaders[metric].length ? (
          <ol class="summary-ranking" data-ranking-sparks={count} hidden={count !== ''}>
            {leaders[metric].map(({ config, value, concurrency }) => (
              <li>
                <div class="summary-row">
                  <div>
                    <a class="summary-model" href={modelUrl(config.id)}>{config.model.name}</a>
                    <p class="summary-meta">{config.sparks}× DGX Spark · {config.runtime}</p>
                    <EvaluationBadges config={config} showUnavailableSafety />
                  </div>
                  <div class="summary-result">
                    <p><strong>{rate(value)}</strong> <span>{unit}</span></p>
                    {concurrency != null && <p class="summary-meta">Concurrency {concurrency}</p>}
                    <div class="summary-actions">
                      <InstallModelButton config={config} />
                      <CompareButton config={config} />
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        ) : <p data-ranking-sparks={count} hidden={count !== ''}>No published measurements for this workload.</p>)}
      </section>
    ))}
  </div>
  <InstallDialog />
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('#summary-filters')!;
  const sparks = filters.querySelector<HTMLSelectElement>('#sparks')!;
  const rankings = document.querySelectorAll<HTMLElement>('[data-ranking-sparks]');

  function showRankings() {
    for (const ranking of rankings) {
      ranking.hidden = ranking.dataset.rankingSparks !== sparks.value;
    }
  }

  function readFilter() {
    sparks.value = new URLSearchParams(location.search).get('sparks') ?? '';
    if (sparks.selectedIndex < 0) sparks.value = '';
    showRankings();
  }

  readFilter();
  filters.hidden = false;
  sparks.addEventListener('change', () => {
    const url = new URL(location.href);
    if (sparks.value) url.searchParams.set('sparks', sparks.value);
    else url.searchParams.delete('sparks');
    history.replaceState(null, '', url);
    showRankings();
  });
  window.addEventListener('popstate', readFilter);
</script>
