---
import Layout from '../../components/Layout.astro';
import ConfigCard from '../../components/ConfigCard.astro';
import InstallDialog from '../../components/InstallDialog.astro';
import SparkCountFilter from '../../components/SparkCountFilter.astro';
import { baselines, decodeWorkload, engines, families } from '../../lib/benchmarks.js';

const safetyOptions = Object.entries({ passed: 'Passed', failed: 'Failed', unavailable: 'Unavailable' })
  .filter(([value]) => baselines.some((config) => config.safetyGate === value));
const toolOptions = Object.entries({ complete: 'Complete', incomplete: 'Incomplete', unsupported: 'Unsupported', unavailable: 'Unavailable' })
  .filter(([value]) => baselines.some((config) => config.toolStatus === value));
---
<Layout title="Model catalog" description="Compare tested DGX Spark serving configurations by hardware, engine, safety gate, and tool evaluation status." catalog>
  <div class="mast">
    <div class="wrap">
      <p class="kicker">DGX Spark benchmarks</p>
      <h1>Model catalog</h1>
      <p class="hero-lead">Filter by hardware, serving engine, and evaluation results. Browse by model or sort across configurations by speed or date.</p>
    </div>
  </div>
  <div class="wrap catalog">
    <div class="card filters" id="filters" hidden>
      <SparkCountFilter />
      <label class="select-label" for="engine">Serving engine
        <select id="engine">
          <option value="">Any engine</option>
          {engines.map((engine) => <option value={engine}>{engine}</option>)}
        </select>
      </label>
      <label class="select-label" for="safety">Safety gate
        <select id="safety">
          <option value="">Any safety result</option>
          {safetyOptions.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label class="select-label" for="tool">Tool evaluation
        <select id="tool">
          <option value="">Any tool status</option>
          {toolOptions.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label class="select-label" for="sort">Sort by
        <select id="sort">
          <option value="">Model groups</option>
          <option value="decode">Single-stream decode</option>
          <option value="sustained">Sustained throughput</option>
          <option value="newest">Newest benchmark</option>
        </select>
      </label>
      <button id="clear" class="button button--outline" type="button">Reset filters</button>
    </div>
    <div class="catalog-summary">
      <p id="result-count" role="status">{baselines.length} configurations across {families.length} models</p>
      <p>Decode sweep · {decodeWorkload}</p>
    </div>
    <p id="empty" class="card empty" hidden>No configurations match these filters.</p>
    <div id="sorted-configurations" class="card-grid" hidden></div>
    {families.map((family) => (
      <section id={family.id} class="family" aria-labelledby={`${family.id}-heading`} data-family>
        <div class="family-heading">
          <h2 id={`${family.id}-heading`}>{family.name}</h2>
          <p data-family-count>{family.configs.length} {family.configs.length === 1 ? 'configuration' : 'configurations'}</p>
        </div>
        <div class="card-grid" data-family-cards>
          {family.configs.map((config) => <ConfigCard config={config} />)}
        </div>
      </section>
    ))}
  </div>
  <InstallDialog />
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('#filters')!;
  const sort = filters.querySelector<HTMLSelectElement>('#sort')!;
  const controls = Array.from(filters.querySelectorAll('select'));
  const selects = controls.filter((select) => select !== sort);
  const count = document.querySelector<HTMLElement>('#result-count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const reset = document.querySelector<HTMLButtonElement>('#clear')!;
  const sorted = document.querySelector<HTMLElement>('#sorted-configurations')!;
  const families = Array.from(document.querySelectorAll<HTMLElement>('[data-family]'), (group) => ({
    group,
    grid: group.querySelector<HTMLElement>('[data-family-cards]')!,
    cards: Array.from(group.querySelectorAll<HTMLElement>('[data-configuration]')),
    count: group.querySelector<HTMLElement>('[data-family-count]')!,
  }));
  const cards = families.flatMap((family) => family.cards);
  let currentSort = '';

  function readControls() {
    const params = new URLSearchParams(location.search);
    for (const select of controls) {
      select.value = params.get(select.id) ?? '';
      if (select.selectedIndex < 0) select.value = '';
    }
    render();
  }

  function arrangeCards() {
    if (currentSort === sort.value) return;
    currentSort = sort.value;
    if (currentSort) {
      // Missing measurements sort after measured results, even when a rate is zero.
      const value = (card: HTMLElement) => Number(card.dataset[currentSort] ?? Number.MIN_SAFE_INTEGER);
      sorted.replaceChildren(...[...cards].sort((a, b) => value(b) - value(a)));
    } else {
      for (const family of families) family.grid.append(...family.cards);
    }
  }

  function render() {
    arrangeCards();
    const activeFilters = selects.filter((select) => select.value);
    let total = 0;
    let models = 0;
    for (const family of families) {
      let matches = 0;
      for (const card of family.cards) {
        card.hidden = activeFilters.some((select) => card.dataset[select.id] !== select.value);
        if (!card.hidden) matches++;
      }
      family.group.hidden = Boolean(currentSort) || matches === 0;
      family.count.textContent = `${matches} ${matches === 1 ? 'configuration' : 'configurations'}`;
      if (matches) models++;
      total += matches;
    }
    count.textContent = `${total} ${total === 1 ? 'configuration' : 'configurations'} across ${models} ${models === 1 ? 'model' : 'models'}`;
    empty.hidden = total > 0;
    sorted.hidden = !currentSort || total === 0;
  }

  function updateControls() {
    const url = new URL(location.href);
    for (const select of controls) {
      if (select.value) url.searchParams.set(select.id, select.value);
      else url.searchParams.delete(select.id);
    }
    history.replaceState(null, '', url);
    render();
  }

  filters.hidden = false;
  readControls();
  filters.addEventListener('change', updateControls);
  reset.addEventListener('click', () => {
    for (const select of selects) select.value = '';
    updateControls();
  });
  window.addEventListener('popstate', readControls);
</script>
